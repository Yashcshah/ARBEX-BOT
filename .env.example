# Helius RPC (get free key at helius.dev)
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE
HELIUS_RPC_FALLBACK_URL=

# Jito Block Engine
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# Your bot wallet private key (base58 — run: npm run wallet)
WALLET_PRIVATE_KEY=YOUR_BASE58_PRIVATE_KEY_HERE

# Birdeye API (get free key at birdeye.so)
BIRDEYE_API_KEY=YOUR_KEY_HERE

# Dashboard secret (protects /stop endpoint)
DASHBOARD_SECRET=change_me_to_something_random

# Set to "true" to enable verbose debug logs
DEBUG=false
